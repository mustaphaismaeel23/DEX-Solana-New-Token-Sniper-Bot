# Solana RPC and wallet settings
RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=
WALLET_PRIVATE_KEY=

# Start in dry-run mode. Set false only after extended testing.
DRY_RUN=true
BUY_SIZE_SOL=0.05
MAX_CONCURRENT_POSITIONS=3
MIN_SOL_RESERVE=0.05
SLIPPAGE_BPS=500

# Scanner and safety settings
WATCH_PUMPFUN=true
WATCH_PUMPSWAP=true
ALLOWED_DEXES=pumpfun,pumpswap
# Required for on-chain PumpSwap pool-owner verification.
PUMPSWAP_PROGRAM_ID=
MIN_LIQUIDITY_USD=50000
MAX_TOP_HOLDER_PCT=20
REQUIRE_MINT_AUTHORITY_RENOUNCED=true
REQUIRE_FREEZE_AUTHORITY_RENOUNCED=true
MIN_TOKEN_AGE_SECONDS=21600
MAX_TOKEN_AGE_SECONDS=86400
REQUIRE_UTILITY_SIGNALS=true
MIN_UTILITY_SCORE=70
MIN_24H_VOLUME_USD=100000
MIN_VOLUME_LIQUIDITY_RATIO=0.5
MAX_VOLUME_LIQUIDITY_RATIO=3.0
MIN_24H_TRANSACTIONS=100
MAX_24H_PRICE_CHANGE_PCT=400

# Risk and circuit breaker settings
MIN_RISK_SCORE=65
MAX_PRICE_IMPACT_PCT=5
MAX_TAX_PCT=10
DAILY_LOSS_THRESHOLD_SOL=0.25
MAX_CONSECUTIVE_LOSSES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=900
CIRCUIT_BREAKER_MANUAL_RESET=true
CIRCUIT_BREAKER_RESET_TOKEN=
PROFIT_TAKE_2X_PCT=50
PROFIT_TAKE_5X_PCT=25
PROFIT_TAKE_10X_REMAINING_PCT=80

# API and dashboard settings
DB_PATH=sniper.db
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
VITE_API_URL=http://localhost:8000

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
